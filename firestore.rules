rules_version = '2';
// 釣り手帳のデータベースのルール
// ・users/{自分のID}/ の下（釣果・釣り場・写真・設定）は、ログインした本人だけが読み書きできる
// ・招待コードで「見る人」に加わった家族は、釣果・釣り場・写真を読むだけできる（書き換え・削除はできない）
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isViewerOf(uid) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid)/viewers/$(request.auth.uid));
    }

    // 自分のデータは自分だけが読み書きできる
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 見せている家族は、釣果・釣り場・写真を読むだけできる
    match /users/{uid}/catches/{id} { allow read: if isViewerOf(uid); }
    match /users/{uid}/spots/{id}   { allow read: if isViewerOf(uid); }
    match /users/{uid}/photos/{id}  { allow read: if isViewerOf(uid); }

    // 招待コードを使って「見る人」に加わる（正しくて期限内のコードの時だけ）。自分から抜けることもできる
    match /users/{uid}/viewers/{viewer} {
      allow create: if signedIn() && request.auth.uid == viewer && request.auth.uid != uid
        && request.resource.data.code is string
        && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.owner == uid
        && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.expires > request.time;
      allow delete: if signedIn() && request.auth.uid == viewer;
    }

    // 招待コード：作った本人だけが作成・削除。コードを知っているログイン済みの人だけが1件ずつ読める（一覧は見られない）
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }
  }
}
